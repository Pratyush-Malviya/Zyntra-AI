{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "python with_server.py --server \"npm run dev\" --port 3000 -- python -m pytest tests/ -v",
    "test:smoke": "python with_server.py --server \"npm run dev\" --port 3000 -- python tests/smoke_test.py",
    "test:login": "python with_server.py --server \"npm run dev\" --port 3000 -- python tests/login_test.py",
    "test:outreach": "python with_server.py --server \"npm run dev\" --port 3000 -- python tests/outreach_flow.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@chakra-ui/react": "^2.10.10",
    "@composio/client": "^0.1.0-alpha.73",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@saas-ui/react": "^2.11.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.0",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.5",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "vite": "^6.2.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
